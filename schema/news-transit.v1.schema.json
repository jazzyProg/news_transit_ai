{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jazzyProg/news_transit_ai/schema/news-transit.v1.schema.json",
  "title": "news-transit/v1",
  "description": "One popularity-ranked news snapshot (latest/<agent>.json) or delta batch (feed/<agent>/...).",
  "type": "object",
  "required": ["schema", "agent", "generated_at", "items"],
  "properties": {
    "schema": {"const": "news-transit/v1"},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9-]+-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{4,8}$"},
    "agent": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"},
        "name": {"type": "string", "maxLength": 120}
      }
    },
    "generated_at": {"type": "integer", "minimum": 1500000000},
    "generated_at_iso": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "window_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 168},
    "count": {"type": "integer", "minimum": 0},
    "selection": {
      "type": "object",
      "description": "How the ranking was produced (informative).",
      "properties": {
        "method": {"type": "string"},
        "weights": {"type": "object"},
        "min_sources": {"type": "integer"},
        "min_score": {"type": "number"}
      }
    },
    "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/definitions/item"}}
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "title", "score"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 120},
        "story_id": {"type": ["integer", "string", "null"]},
        "title": {"type": "string", "minLength": 3, "maxLength": 400},
        "summary": {"type": "string", "maxLength": 2000},
        "category": {
          "type": ["string", "null"],
          "enum": ["weather", "wildfires", "accidents", "crime", "missing", "public-safety", "earthquakes",
                   "breaking", "trending", null]
        },
        "niche": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"], "pattern": "^([A-Z]{2})?$"},
        "score": {"type": "number"},
        "score_reasons": {"type": "object", "additionalProperties": {"type": "number"}},
        "first_published": {"type": ["integer", "null"]},
        "last_published": {"type": ["integer", "null"]},
        "outlets": {
          "type": "object",
          "properties": {
            "total": {"type": "integer", "minimum": 0, "description": "Distinct newsrooms/feeds reporting the story as titled (aggregators excluded)."},
            "cluster": {"type": "integer", "minimum": 0, "description": "All feeds in the publisher's story cluster, including loosely related updates."},
            "updates": {"type": "integer", "minimum": 0},
            "names": {"type": "array", "items": {"type": "string"}}
          }
        },
        "credibility": {
          "type": "object",
          "description": "How far the evidence goes: consensus, not an independent fact-check.",
          "properties": {
            "status": {"type": "string", "enum": ["Confirmed", "Developing", "Unverified"]},
            "independent_newsrooms": {"type": "integer", "minimum": 0},
            "official_sources": {"type": "array", "items": {"type": "string"}},
            "tier_mix": {"type": "object", "additionalProperties": {"type": "integer"}},
            "aggregators": {"type": "array", "items": {"type": "string"}},
            "cluster_outlets": {"type": "integer", "minimum": 0},
            "notice": {"type": ["string", "null"]}
          }
        },
        "lead": {
          "type": ["object", "null"],
          "properties": {
            "outlet": {"type": "string"},
            "title": {"type": "string"},
            "url": {"type": "string", "format": "uri"},
            "published": {"type": "integer"}
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["outlet", "url"],
            "properties": {
              "outlet": {"type": "string"},
              "title": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "published": {"type": "integer"},
              "niche": {"type": ["string", "null"]},
              "via": {"type": "string"}
            }
          }
        },
        "instagram": {
          "type": "object",
          "properties": {
            "accounts": {"type": "integer", "minimum": 0},
            "posts": {"type": "integer", "minimum": 0},
            "likes": {"type": "integer", "minimum": 0},
            "comments": {"type": "integer", "minimum": 0},
            "viral_x": {"type": ["number", "null"]},
            "watchlist": {"type": "array", "items": {"type": "string"}},
            "top": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": ["account", "url"],
                "properties": {
                  "account": {"type": "string"},
                  "url": {"type": "string", "format": "uri"},
                  "caption": {"type": "string", "maxLength": 1200},
                  "posted_at": {"type": ["integer", "null"]},
                  "likes": {"type": ["integer", "null"]},
                  "comments": {"type": ["integer", "null"]},
                  "viral_x": {"type": ["number", "null"]},
                  "date_only": {"type": "boolean"},
                  "lag_minutes": {"type": ["integer", "null"]}
                }
              }
            }
          }
        },
        "trend": {
          "type": ["object", "null"],
          "properties": {
            "term": {"type": "string"},
            "searches": {"type": "string"},
            "news": {"type": ["string", "null"]},
            "url": {"type": "string", "format": "uri"}
          }
        },
        "entities": {"type": "array", "items": {"type": "string"}},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{8,40}$"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{8,40}$"},
        "article": {
          "type": ["object", "null"],
          "properties": {
            "headline": {"type": "string"},
            "dek": {"type": "string"},
            "body": {"type": "array", "items": {"type": "string"}},
            "key_points": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
